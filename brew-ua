#!/bin/zsh

# ============================================================
#  brew-update-all  —  逐个升级 Homebrew formula 和 cask
# ============================================================

# 严格模式：未定义变量立即报错 + 管道失败传播
# （不开 set -e：设计上要"一个包失败继续下一个"）
setopt nounset
setopt pipefail

# ---------- 颜色主题 ----------
autoload -U colors && colors

C_RESET=$'\033[0m'
C_BOLD=$'\033[1m'
C_DIM=$'\033[2m'
C_ITALIC=$'\033[3m'
C_UNDERLINE=$'\033[4m'

C_PRIMARY=$'\033[38;5;75m'
C_SUCCESS=$'\033[38;5;78m'
C_ERROR=$'\033[38;5;203m'
C_WARN=$'\033[38;5;222m'
C_INFO=$'\033[38;5;146m'
C_FORMULA=$'\033[38;5;110m'
C_CASK=$'\033[38;5;180m'
C_BORDER=$'\033[38;5;240m'
C_PROGRESS_BG=$'\033[38;5;237m'
C_PROGRESS_FG=$'\033[38;5;75m'
C_MUTED=$'\033[38;5;245m'
C_ACCENT=$'\033[38;5;213m'

# ---------- 边框字符 ----------
B_H="─" B_V="│" B_TL="┌" B_TR="┐" B_BL="└" B_BR="┘"
B_L="├" B_R="┤" B_T="┬" B_B="┴" B_C="┼"

# ---------- 非 TTY 降级 ----------
# 管道/重定向/CI 下关闭颜色与光标控制，退化为纯文本逐行输出
TTY_MODE=1
[[ -t 1 ]] || TTY_MODE=0
if (( TTY_MODE == 0 )); then
  C_RESET=""; C_BOLD=""; C_DIM=""; C_ITALIC=""; C_UNDERLINE=""
  C_PRIMARY=""; C_SUCCESS=""; C_ERROR=""; C_WARN=""; C_INFO=""
  C_FORMULA=""; C_CASK=""; C_BORDER=""; C_PROGRESS_BG=""; C_PROGRESS_FG=""
  C_MUTED=""; C_ACCENT=""
  B_H="-" B_V="|" B_TL="+" B_TR="+" B_BL="+" B_BR="+"
  B_L="+" B_R="+" B_T="+" B_B="+" B_C="+"
fi

# ---------- spinner 动画帧 ----------
SPIN_FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")

# ---------- 工具函数 ----------

function _print_help() {
  cat <<EOF
${C_BOLD}brew ua${C_RESET} — 逐个升级 Homebrew formula 和 cask

${C_BOLD}升级模式:${C_RESET}
  ${C_PRIMARY}（空）${C_RESET}      交互模式，输入序号选择
  ${C_PRIMARY}a / auto${C_RESET}     自动模式，全部升级
  ${C_PRIMARY}f / formula${C_RESET}  只升级 formula
  ${C_PRIMARY}c / cask${C_RESET}     只升级 cask

${C_BOLD}子命令:${C_RESET}
  ${C_PRIMARY}ck / check${C_RESET}              运行环境诊断
  ${C_PRIMARY}ig / ignore <cask>${C_RESET}       屏蔽指定 cask
  ${C_PRIMARY}uig / unignore <cask>${C_RESET}    解除屏蔽
  ${C_PRIMARY}igl / ignored${C_RESET}            查看屏蔽列表

${C_BOLD}选项:${C_RESET}
  ${C_PRIMARY}-a${C_RESET}           包含自带自动更新的 cask（--greedy）
  ${C_PRIMARY}--prune${C_RESET}       升级后深度清理下载缓存
  ${C_PRIMARY}--clean-logs${C_RESET}  升级后清理本次产生的临时日志

${C_BOLD}示例:${C_RESET}
  brew ua                     交互选择
  brew ua a                   自动全部升级
  brew ua f                   只升级 formula
  brew ua c -a                只升级 cask（含自动更新的应用）
  brew ua ck                  运行环境诊断
  brew ua ig firefox          屏蔽 firefox
  brew ua uig firefox         解除 firefox 屏蔽
  brew ua igl                 查看屏蔽列表
EOF
}

function _repeat_char() {
  local char="$1" count="$2"
  printf "%${count}s" "" | tr " " "$char"
}

function _fmt_duration() {
  local total=$1
  if (( total < 60 )); then
    printf "%ds" "$total"
  elif (( total < 3600 )); then
    printf "%dm%ds" $(( total / 60 )) $(( total % 60 ))
  else
    printf "%dh%dm%ds" $(( total / 3600 )) $(( (total % 3600) / 60 )) $(( total % 60 ))
  fi
}

function _fmt_size() {
  local bytes=$1
  if (( bytes < 1024 )); then
    printf "%dB" "$bytes"
  elif (( bytes < 1048576 )); then
    printf "%.1fKB" $(( bytes / 1024.0 ))
  elif (( bytes < 1073741824 )); then
    printf "%.1fMB" $(( bytes / 1048576.0 ))
  else
    printf "%.1fGB" $(( bytes / 1073741824.0 ))
  fi
}

function _parse_size() {
  local size_str=$1
  local num=$(echo "$size_str" | grep -oE '[0-9.]+')
  local unit=$(echo "$size_str" | grep -oE '[kKMGT]i?B?$')
  local bytes=0
  case "$unit" in
    k|K|KB|KiB|kB) bytes=$(awk "BEGIN {printf \"%.0f\", $num * 1024}") ;;
    m|M|MB|MiB) bytes=$(awk "BEGIN {printf \"%.0f\", $num * 1048576}") ;;
    g|G|GB|GiB) bytes=$(awk "BEGIN {printf \"%.0f\", $num * 1073741824}") ;;
    t|T|TB|TiB) bytes=$(awk "BEGIN {printf \"%.0f\", $num * 1099511627776}") ;;
    *) bytes=$(printf "%.0f" "$num") ;;
  esac
  echo "$bytes"
}

function _fmt_speed() {
  local bytes_per_sec=$1
  if (( bytes_per_sec < 1024 )); then
    printf "%dB/s" "$bytes_per_sec"
  elif (( bytes_per_sec < 1048576 )); then
    printf "%.1fKB/s" $(( bytes_per_sec / 1024.0 ))
  elif (( bytes_per_sec < 1073741824 )); then
    printf "%.1fMB/s" $(( bytes_per_sec / 1048576.0 ))
  else
    printf "%.1fGB/s" $(( bytes_per_sec / 1073741824.0 ))
  fi
}

function _get_terminal_width() {
  local w=${COLUMNS:-80}
  echo "$w"
}

# ---------- 诊断功能 ----------

function _ping_host() {
  local host="$1" timeout="${2:-5}"
  local result
  result=$(curl -o /dev/null -s -w "%{time_total},%{http_code}" --max-time "$timeout" "$host" 2>/dev/null)
  echo "$result"
}

function _fmt_ping() {
  local time_ms="$1"
  if [[ -z "$time_ms" || "$time_ms" == "0" ]]; then
    echo "${C_ERROR}超时${C_RESET}"
  elif (( $(echo "$time_ms < 0.5" | bc -l) )); then
    echo "${C_SUCCESS}$(printf "%.0f" $(echo "$time_ms * 1000" | bc))ms${C_RESET}"
  elif (( $(echo "$time_ms < 1.5" | bc -l) )); then
    echo "${C_WARN}$(printf "%.0f" $(echo "$time_ms * 1000" | bc))ms${C_RESET}"
  else
    echo "${C_ERROR}$(printf "%.0f" $(echo "$time_ms * 1000" | bc))ms${C_RESET}"
  fi
}

function _check_network() {
  echo "${C_BOLD}📡 网络环境检测${C_RESET}"
  echo ""

  # 地理位置检测
  echo -n "  ${C_MUTED}地理位置:${C_RESET} "
  local geo_info
  geo_info=$(curl -s --max-time 5 "https://ipinfo.io/country" 2>/dev/null | tr -d '\n')
  if [[ -n "$geo_info" && ${#geo_info} -le 3 ]]; then
    if [[ "$geo_info" == "CN" ]]; then
      echo "${C_WARN}中国大陆${C_RESET} ${C_MUTED}(建议配置国内镜像源)${C_RESET}"
    else
      echo "${C_SUCCESS}$geo_info${C_RESET}"
    fi
  else
    echo "${C_MUTED}未知${C_RESET}"
  fi

  # GitHub 连通性
  echo -n "  ${C_MUTED}GitHub 访问:${C_RESET} "
  local github_ping
  github_ping=$(_ping_host "https://github.com" 8)
  local github_time=$(echo "$github_ping" | cut -d',' -f1)
  local github_code=$(echo "$github_ping" | cut -d',' -f2)
  if [[ "$github_code" == "200" || "$github_code" == "301" || "$github_code" == "302" ]]; then
    echo "$(_fmt_ping "$github_time") ${C_MUTED}(HTTP $github_code)${C_RESET}"
  else
    echo "${C_ERROR}无法访问${C_RESET} ${C_MUTED}(可能需配置代理)${C_RESET}"
  fi

  # GitHub API
  echo -n "  ${C_MUTED}GitHub API:${C_RESET}  "
  local api_ping
  api_ping=$(_ping_host "https://api.github.com" 8)
  local api_time=$(echo "$api_ping" | cut -d',' -f1)
  local api_code=$(echo "$api_ping" | cut -d',' -f2)
  if [[ "$api_code" == "200" || "$api_code" == "403" || "$api_code" == "404" ]]; then
    echo "$(_fmt_ping "$api_time") ${C_MUTED}(HTTP $api_code)${C_RESET}"
  else
    echo "${C_ERROR}无法访问${C_RESET}"
  fi

  # brew 官方源
  echo -n "  ${C_MUTED}brew 官方源:${C_RESET} "
  local brew_ping
  brew_ping=$(_ping_host "https://formulae.brew.sh" 8)
  local brew_time=$(echo "$brew_ping" | cut -d',' -f1)
  local brew_code=$(echo "$brew_ping" | cut -d',' -f2)
  if [[ "$brew_code" == "200" || "$brew_code" == "301" || "$brew_code" == "302" ]]; then
    echo "$(_fmt_ping "$brew_time") ${C_MUTED}(HTTP $brew_code)${C_RESET}"
  else
    echo "${C_ERROR}无法访问${C_RESET}"
  fi

  # 代理检测
  echo -n "  ${C_MUTED}代理设置:${C_RESET}  "
  local proxy_set=""
  [[ -n "$http_proxy" ]] && proxy_set="http_proxy"
  [[ -n "$https_proxy" ]] && proxy_set="${proxy_set:+,}https_proxy"
  [[ -n "$ALL_PROXY" ]] && proxy_set="${proxy_set:+,}ALL_PROXY"
  if [[ -n "$proxy_set" ]]; then
    echo "${C_SUCCESS}已配置${C_RESET} ${C_MUTED}($proxy_set)${C_RESET}"
  else
    echo "${C_WARN}未配置${C_RESET}"
  fi

  echo ""
}

function _check_taps() {
  echo "${C_BOLD}📦 Tap 源检测${C_RESET}"
  echo ""

  local taps
  taps=($(brew tap 2>/dev/null))
  local tap_count=${#taps[@]}

  if (( tap_count == 0 )); then
    echo "  ${C_WARN}⚠ 未安装任何 tap${C_RESET}"
    echo ""
    return
  fi

  for t in "${taps[@]}"; do
    [[ -z "$t" ]] && continue
    local tap_url
    tap_url=$(brew tap-info "$t" --json 2>/dev/null | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0].get('remote',''))" 2>/dev/null)

    echo -n "  ${C_MUTED}$t${C_RESET} "

    # 识别国内镜像
    local mirror_type=""
    if [[ "$tap_url" == *"mirrors.ustc.edu.cn"* || "$tap_url" == *"ustc"* ]]; then
      mirror_type="${C_SUCCESS}[中科大镜像]${C_RESET}"
    elif [[ "$tap_url" == *"mirrors.tuna.tsinghua.edu.cn"* || "$tap_url" == *"tsinghua"* ]]; then
      mirror_type="${C_SUCCESS}[清华镜像]${C_RESET}"
    elif [[ "$tap_url" == *"mirrors.aliyun.com"* || "$tap_url" == *"aliyun"* ]]; then
      mirror_type="${C_SUCCESS}[阿里镜像]${C_RESET}"
    elif [[ "$tap_url" == *"github.com"* ]]; then
      mirror_type="${C_MUTED}[官方源]${C_RESET}"
    fi

    # 检测源速度
    local tap_speed
    if [[ -d "$(brew --prefix)/Library/Taps/$t" ]]; then
      local fetch_out
      fetch_out=$(cd "$(brew --prefix)/Library/Taps/$t" && git fetch --dry-run 2>&1)
      if [[ "$fetch_out" == *"fatal"* || "$fetch_out" == *"error"* || "$fetch_out" == *"Could not resolve"* ]]; then
        echo "${C_ERROR}✗ 异常${C_RESET} $mirror_type"
      else
        echo "${C_SUCCESS}✓ 正常${C_RESET} $mirror_type"
      fi
    else
      echo "${C_WARN}⚠ 路径异常${C_RESET}"
    fi
  done

  echo ""
}

function _check_local() {
  echo "${C_BOLD}⚙️  本地配置检测${C_RESET}"
  echo ""

  # brew 版本
  echo -n "  ${C_MUTED}brew 版本:${C_RESET}    "
  local brew_version
  brew_version=$(brew --version 2>/dev/null | head -1)
  if [[ -n "$brew_version" ]]; then
    echo "${C_SUCCESS}$brew_version${C_RESET}"
  else
    echo "${C_ERROR}无法获取${C_RESET}"
  fi

  # Git 配置
  echo -n "  ${C_MUTED}Git 配置:${C_RESET}     "
  local git_name git_email
  git_name=$(git config --global user.name 2>/dev/null)
  git_email=$(git config --global user.email 2>/dev/null)
  if [[ -n "$git_name" && -n "$git_email" ]]; then
    echo "${C_SUCCESS}已设置${C_RESET} ${C_MUTED}($git_name)${C_RESET}"
  else
    echo "${C_WARN}未完全设置${C_RESET} ${C_MUTED}(brew 操作可能受影响)${C_RESET}"
  fi

  # 缓存目录
  echo -n "  ${C_MUTED}缓存空间:${C_RESET}     "
  local cache_dir="$HOME/Library/Caches/Homebrew"
  if [[ -d "$cache_dir" ]]; then
    local cache_size
    cache_size=$(du -sh "$cache_dir" 2>/dev/null | awk '{print $1}')
    echo "${C_INFO}$cache_size${C_RESET} ${C_MUTED}($cache_dir)${C_RESET}"
  else
    echo "${C_MUTED}未找到${C_RESET}"
  fi

  # 磁盘空间
  echo -n "  ${C_MUTED}磁盘空间:${C_RESET}     "
  local disk_info
  disk_info=$(df -h "$HOME" 2>/dev/null | awk 'NR==2 {print $4}')
  if [[ -n "$disk_info" ]]; then
    echo "${C_SUCCESS}可用 $disk_info${C_RESET}"
  else
    echo "${C_MUTED}未知${C_RESET}"
  fi

  # 环境变量
  local env_vars=""
  [[ -n "$HOMEBREW_NO_AUTO_UPDATE" ]] && env_vars="${env_vars:+,}NO_AUTO_UPDATE"
  [[ -n "$HOMEBREW_BOTTLE_DOMAIN" ]] && env_vars="${env_vars:+,}BOTTLE_DOMAIN"
  [[ -n "$HOMEBREW_CORE_GIT_REMOTE" ]] && env_vars="${env_vars:+,}CORE_GIT_REMOTE"
  if [[ -n "$env_vars" ]]; then
    echo "  ${C_MUTED}环境变量:${C_RESET}     ${C_INFO}已设置${C_RESET} ${C_MUTED}($env_vars)${C_RESET}"
  fi

  echo ""
}

function _print_diagnose_tips() {
  local in_china="$1"
  echo "${C_BOLD}💡 优化建议${C_RESET}"
  echo ""

  if [[ "$in_china" == "yes" ]]; then
    echo "  ${C_WARN}检测到中国大陆网络环境，建议配置国内镜像源:${C_RESET}"
    echo ""
    echo "  ${C_PRIMARY}中科大镜像:${C_RESET}"
    echo "    export HOMEBREW_BREW_GIT_REMOTE=\"https://mirrors.ustc.edu.cn/brew.git\""
    echo "    export HOMEBREW_CORE_GIT_REMOTE=\"https://mirrors.ustc.edu.cn/homebrew-core.git\""
    echo "    export HOMEBREW_BOTTLE_DOMAIN=\"https://mirrors.ustc.edu.cn/homebrew-bottles\""
    echo ""
    echo "  ${C_PRIMARY}清华镜像:${C_RESET}"
    echo "    export HOMEBREW_BREW_GIT_REMOTE=\"https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/brew.git\""
    echo "    export HOMEBREW_CORE_GIT_REMOTE=\"https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/homebrew-core.git\""
    echo "    export HOMEBREW_BOTTLE_DOMAIN=\"https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles\""
    echo ""
    echo "  ${C_MUTED}将以上 export 加入 ~/.zshrc 后 source ~/.zshrc 生效${C_RESET}"
  else
    echo "  ${C_SUCCESS}当前网络环境良好，无需特殊配置${C_RESET}"
  fi

  echo ""
}

function _run_diagnose() {
  local check_net=1 check_tap=1 check_local=1

  # 解析诊断选项
  for arg in "$@"; do
    case "$arg" in
      -n|--net) check_tap=0; check_local=0 ;;
      -t|--tap) check_net=0; check_local=0 ;;
      -l|--local) check_net=0; check_tap=0 ;;
      -h|--help)
        echo "${C_BOLD}brew ua ck${C_RESET} — 环境诊断"
        echo ""
        echo "${C_BOLD}用法:${C_RESET}"
        echo "  brew ua ck          完整诊断"
        echo "  brew ua ck -n       仅检测网络环境"
        echo "  brew ua ck -t       仅检测 Tap 源"
        echo "  brew ua ck -l       仅检测本地配置"
        exit 0
        ;;
    esac
  done

  echo ""
  echo "${C_BOLD}${C_PRIMARY}┌─────────────────────────────────────────────┐${C_RESET}"
  echo "${C_BOLD}${C_PRIMARY}│         🔍 brew-update-all 诊断报告          │${C_RESET}"
  echo "${C_BOLD}${C_PRIMARY}└─────────────────────────────────────────────┘${C_RESET}"
  echo ""

  local is_china="no"
  local country
  country=$(curl -s --max-time 5 "https://ipinfo.io/country" 2>/dev/null | tr -d '\n')
  [[ "$country" == "CN" ]] && is_china="yes"

  (( check_net )) && _check_network
  (( check_tap )) && _check_taps
  (( check_local )) && _check_local

  if (( check_net && check_tap && check_local )); then
    _print_diagnose_tips "$is_china"
  fi
}

# ---------- 屏蔽列表功能 ----------
IGNORED_FILE="$HOME/.config/brew-ua/ignored_casks"

function _ensure_ignored_file() {
  local dir
  dir=$(dirname "$IGNORED_FILE")
  [[ ! -d "$dir" ]] && mkdir -p "$dir"
  [[ ! -f "$IGNORED_FILE" ]] && touch "$IGNORED_FILE"
}

function _is_cask_ignored() {
  local cask_name="$1"
  _ensure_ignored_file
  grep -qxF "$cask_name" "$IGNORED_FILE" 2>/dev/null
}

function _add_ignored_cask() {
  local cask_name="$1"
  _ensure_ignored_file
  if _is_cask_ignored "$cask_name"; then
    return 1
  else
    echo "$cask_name" >> "$IGNORED_FILE"
    return 0
  fi
}

function _remove_ignored_cask() {
  local cask_name="$1"
  _ensure_ignored_file
  if _is_cask_ignored "$cask_name"; then
    local tmp_file
    tmp_file=$(mktemp)
    grep -vxF "$cask_name" "$IGNORED_FILE" > "$tmp_file"
    mv "$tmp_file" "$IGNORED_FILE"
    return 0
  else
    return 1
  fi
}

function _list_ignored_casks() {
  _ensure_ignored_file
  cat "$IGNORED_FILE"
}

function _count_ignored_casks() {
  _ensure_ignored_file
  wc -l < "$IGNORED_FILE" | tr -d ' '
}

function _draw_top_border() {
  local title="$1" width
  width=$(_get_terminal_width)
  (( width = width < 60 ? 60 : width ))
  local title_len=$(( ${#title} + 2 ))
  local pad_left=$(( (width - title_len - 2) / 2 ))
  local pad_right=$(( width - title_len - 2 - pad_left ))

  echo -n "${C_BORDER}${B_TL}$(_repeat_char "$B_H" "$pad_left")"
  echo -n "${C_RESET} ${C_BOLD}${C_PRIMARY}${title}${C_RESET} ${C_BORDER}"
  echo -n "$(_repeat_char "$B_H" "$pad_right")${B_TR}${C_RESET}"
  echo ""
}

function _draw_bottom_border() {
  local width
  width=$(_get_terminal_width)
  (( width = width < 60 ? 60 : width ))
  echo "${C_BORDER}${B_BL}$(_repeat_char "$B_H" $(( width - 2 )))${B_BR}${C_RESET}"
}

function _draw_mid_border() {
  local width
  width=$(_get_terminal_width)
  (( width = width < 60 ? 60 : width ))
  echo "${C_BORDER}${B_L}$(_repeat_char "$B_H" $(( width - 2 )))${B_R}${C_RESET}"
}

function _line_left() {
  local content="$1"
  local width
  width=$(_get_terminal_width)
  (( width = width < 60 ? 60 : width ))
  local stripped="${content//$'\033'[0-9;]*[a-zA-Z]/}"
  local visible=${#stripped}
  local pad=$(( width - 2 - visible ))
  (( pad < 1 )) && pad=1
  echo "${C_BORDER}${B_V}${C_RESET} ${content}${C_BORDER}$(printf "%${pad}s" " ")${B_V}${C_RESET}"
}

function _line_centered() {
  local content="$1"
  local width
  width=$(_get_terminal_width)
  (( width = width < 60 ? 60 : width ))
  local stripped="${content//$'\033'[0-9;]*[a-zA-Z]/}"
  local visible=${#stripped}
  local total_pad=$(( width - 2 - visible ))
  (( total_pad < 2 )) && total_pad=2
  local left=$(( total_pad / 2 ))
  local right=$(( total_pad - left ))
  echo "${C_BORDER}${B_V}${C_RESET}$(printf "%${left}s" " ")${content}$(printf "%${right}s" " ")${C_BORDER}${B_V}${C_RESET}"
}

function _progress_bar() {
  local current_bytes=$1 total_bytes=$2 current_idx=$3 total_pkgs=$4
  local width
  width=$(_get_terminal_width)
  (( width = width < 60 ? 60 : width ))

  local bar_width=$(( width - 26 ))
  (( bar_width < 10 )) && bar_width=10

  local percent=0
  local filled=0
  if (( total_bytes > 0 )); then
    percent=$(( current_bytes * 100 / total_bytes ))
    filled=$(( current_bytes * bar_width / total_bytes ))
  elif (( total_pkgs > 0 )); then
    percent=$(( current_idx * 100 / total_pkgs ))
    filled=$(( current_idx * bar_width / total_pkgs ))
  fi
  local empty=$(( bar_width - filled ))

  local bar="${C_PROGRESS_FG}$(_repeat_char "█" "$filled")${C_PROGRESS_BG}$(_repeat_char "░" "$empty")${C_RESET}"

  printf "${C_BORDER}${B_V}${C_RESET} ${bar} ${C_BOLD}${C_PRIMARY}%3d%%${C_RESET} ${C_MUTED}(%d/%d)${C_RESET} ${C_BORDER}${B_V}${C_RESET}\n" "$percent" "$current_idx" "$total_pkgs"
}

function _section_title() {
  local icon="$1" title="$2"
  echo ""
  echo "${C_BOLD}${C_PRIMARY}${icon} ${title}${C_RESET}"
  echo "${C_DIM}$(_repeat_char "─" $(( ${#title} + 4 )))${C_RESET}"
}

function _hide_cursor() {
  (( TTY_MODE )) && printf "\033[?25l"
}

function _show_cursor() {
  (( TTY_MODE )) && printf "\033[?25h"
}

function _cleanup_and_exit() {
  _show_cursor
  [[ -n "${LOCK_FILE:-}" ]] && rm -f "$LOCK_FILE"
  echo ""
  exit 130
}

function _cursor_up() {
  local n=${1:-1}
  (( TTY_MODE )) && printf "\033[%dA" "$n"
}

function _cursor_down() {
  local n=${1:-1}
  (( TTY_MODE )) && printf "\033[%dB" "$n"
}

function _clear_line() {
  (( TTY_MODE )) && printf "\r\033[K"
}

function _clr_line() {
  (( TTY_MODE )) && printf "\033[2K"
}

function _progress_bar_with_spinner() {
  local current=$1 total=$2 spin_idx=$3 pkg_name=$4 pkg_type=$5 pkg_icon=$6 type_color=$7
  local width
  width=$(_get_terminal_width)
  (( width = width < 60 ? 60 : width ))

  local bar_width=$(( width - 20 ))
  (( bar_width < 10 )) && bar_width=10

  local percent=$(( current * 100 / total ))
  local filled=$(( current * bar_width / total ))
  local empty=$(( bar_width - filled ))

  local bar="${C_PROGRESS_FG}$(_repeat_char "█" "$filled")${C_PROGRESS_BG}$(_repeat_char "░" "$empty")${C_RESET}"

  echo "${C_BORDER}${B_V}${C_RESET} ${bar} ${C_BOLD}${C_PRIMARY}$(printf "%3d" "$percent")%%${C_RESET} ${C_MUTED}(%d/%d)${C_RESET} ${C_BORDER}${B_V}${C_RESET}" "$current" "$total"

  local spin_count=${#SPIN_FRAMES[@]}
  local spin_pos=$(( (spin_idx % spin_count) + 1 ))
  local spin_char="$SPIN_FRAMES[$spin_pos]"
  local status_line="     ${C_PRIMARY}${spin_char}${C_RESET} ${pkg_icon} ${type_color}${pkg_name}${C_RESET} ${C_MUTED}(${pkg_type})${C_RESET} ${C_INFO}升级中...${C_RESET}"
  local visible=$(( ${#pkg_name} + 30 ))
  local pad=$(( width - 2 - visible ))
  (( pad < 1 )) && pad=1
  echo "${C_BORDER}${B_V}${C_RESET}${status_line}${C_BORDER}$(printf "%${pad}s" " ")${B_V}${C_RESET}"
}

function _sub_progress_bar() {
  local current=$1 total=$2 status_text="$3" spin_idx=$4
  local width
  width=$(_get_terminal_width)
  (( width = width < 60 ? 60 : width ))

  local bar_width=$(( width - 30 ))
  (( bar_width < 10 )) && bar_width=10

  local percent=0
  local filled=0
  local percent_str=""
  if (( total > 0 )); then
    percent=$(( current * 100 / total ))
    filled=$(( current * bar_width / total ))
    percent_str=$(printf "%3d%%" "$percent")
  else
    percent_str="  ?"
    local spin_count=${#SPIN_FRAMES[@]}
    local spin_pos=$(( (spin_idx % spin_count) + 1 ))
    local spin_char="$SPIN_FRAMES[$spin_pos]"
    local half_bar=$(( bar_width / 2 - 1 ))
    local bar_content="$(_repeat_char "░" "$half_bar")${C_ACCENT}${spin_char}${C_PROGRESS_BG}$(_repeat_char "░" $(( bar_width - half_bar - 1 )))"
    local bar="${C_PROGRESS_BG}${bar_content}${C_RESET}"
    local line="     ${bar} ${C_BOLD}${C_ACCENT}${percent_str} ${C_INFO}${status_text}${C_RESET}"

    local visible=0
    local stripped="${line//$'\033'[0-9;]*[a-zA-Z]/}"
    visible=${#stripped}
    local pad=$(( width - 2 - visible ))
    (( pad < 1 )) && pad=1
    echo "${C_BORDER}${B_V}${C_RESET}${line}${C_BORDER}$(printf "%${pad}s" " ")${B_V}${C_RESET}"
    return
  fi
  local empty=$(( bar_width - filled ))

  local bar="${C_ACCENT}$(_repeat_char "▌" "$filled")${C_PROGRESS_BG}$(_repeat_char "░" "$empty")${C_RESET}"
  local line="     ${bar} ${C_BOLD}${C_ACCENT}${percent_str}${C_RESET} ${C_INFO}${status_text}${C_RESET}"

  local visible=0
  local stripped="${line//$'\033'[0-9;]*[a-zA-Z]/}"
  visible=${#stripped}
  local pad=$(( width - 2 - visible ))
  (( pad < 1 )) && pad=1
  echo "${C_BORDER}${B_V}${C_RESET}${line}${C_BORDER}$(printf "%${pad}s" " ")${B_V}${C_RESET}"
}

# ---------- 下载阶段 ----------
# _run_fetch <name> <type> <idx> —— 下载单个包（后台 fetch + 日志解析速度 + 超时）
# 副作用：更新 pkg_size / size_display / pkg_sizes[idx] / total_size（供安装阶段使用）
# 返回：0=成功 1=失败 2=超时
function _run_fetch() {
  local name=$1 type=$2 idx=$3
  local fetch_flag=$([[ "$type" == "cask" ]] && echo "--cask" || echo "--formula")
  local type_color=$([[ "$type" == "cask" ]] && echo "$C_CASK" || echo "$C_FORMULA")
  local type_icon=$([[ "$type" == "cask" ]] && echo "📱" || echo "🍺")
  local log_file="$TMP_BASE/$name.log"
  local fetch_timeout=${BREW_UA_FETCH_TIMEOUT:-600}

  # 回到3行块顶，画下载初始界面
  _cursor_up 3
  _clr_line
  local dl_init="${C_PRIMARY}⠋${C_RESET} ${type_icon} ${type_color}${name}${C_RESET} ${C_MUTED}(${type})${size_display} ${C_INFO}下载中...${C_RESET}"
  local dl_init_s="${dl_init//$'\033'[0-9;]*[a-zA-Z]/}"
  local dl_init_p=$(( $(_get_terminal_width) - 2 - ${#dl_init_s} ))
  (( dl_init_p < 1 )) && dl_init_p=1
  echo "${C_BORDER}${B_V}${C_RESET} ${dl_init}${C_BORDER}$(printf "%${dl_init_p}s" " ")${B_V}${C_RESET}"
  _progress_bar "$completed_size" "$total_size" "$(( current_idx - 1 ))" "$num_selected"
  _sub_progress_bar 0 0 "下载中..." 0

  # 后台 fetch：python setsid 包装 script，使 fetch 自成进程组（超时整组 kill）
  # （Homebrew 6.x 不接受 "brew --verbose fetch"，用环境变量 HOMEBREW_VERBOSE=1）
  local fetch_pid
  python3 -c 'import os,sys; os.setsid(); os.execv(sys.argv[1], sys.argv[1:])' /usr/bin/script -e -q /dev/null env HOMEBREW_VERBOSE=1 brew fetch "$fetch_flag" "$name" > "$log_file" 2>&1 &
  fetch_pid=$!

  # 下载轮询：解析日志 "Downloading X/Y" 算速度 + 超时检查，重画 3 行
  spin_idx=0
  local downloaded=0
  local speed_bytes=0
  local prev_bytes=0
  local prev_ms=$(( EPOCHREALTIME * 1000 ))
  local fetch_start=$(date +%s)
  local timed_out=0
  while kill -0 "$fetch_pid" 2>/dev/null; do
    # 超时检查：超过 BREW_UA_FETCH_TIMEOUT 秒则整组终止
    if (( $(date +%s) - fetch_start > fetch_timeout )); then
      kill -TERM -- -$fetch_pid 2>/dev/null
      sleep 2
      kill -KILL -- -$fetch_pid 2>/dev/null
      wait "$fetch_pid" 2>/dev/null
      timed_out=1
      break
    fi
    # 解析 Downloading X/Y
    local dl_line=""
    [[ -f "$log_file" ]] && dl_line=$(grep -oE 'Downloading[[:space:]]+[0-9.]+ ?[kKMGT]?i?B?[[:space:]]*/[[:space:]]*[0-9.]+ ?[kKMGT]?i?B?' "$log_file" 2>/dev/null | tail -1)
    if [[ -n "$dl_line" ]]; then
      local dl_cur=$(echo "$dl_line" | grep -oE '[0-9.]+ ?[kKMGT]?i?B?' | head -1)
      local dl_tot=$(echo "$dl_line" | grep -oE '[0-9.]+ ?[kKMGT]?i?B?' | tail -1)
      local tot_bytes=$(_parse_size "$dl_tot")
      downloaded=$(_parse_size "$dl_cur")
      if (( pkg_size <= 0 && tot_bytes > 0 )); then
        pkg_size=$tot_bytes
        size_display=" ${C_MUTED}· $(_fmt_size $pkg_size)${C_RESET}"
        total_size=$(( total_size - pkg_sizes[idx] + pkg_size ))
        pkg_sizes[$idx]=$pkg_size
      fi
    fi
    # 速度计算（200ms 窗口）
    local now_ms=$(( EPOCHREALTIME * 1000 ))
    local dt_ms=$(( now_ms - prev_ms ))
    if (( dt_ms >= 200 )); then
      local delta=$(( downloaded - prev_bytes ))
      (( delta < 0 )) && delta=0
      speed_bytes=$(( int(delta * 1000.0 / dt_ms) ))
      prev_bytes=$downloaded
      prev_ms=$now_ms
    fi
    # 重画 3 行
    local spin_count=${#SPIN_FRAMES[@]}
    local spin_pos=$(( (spin_idx % spin_count) + 1 ))
    local spin_char="$SPIN_FRAMES[$spin_pos]"
    local speed_display=""
    (( speed_bytes > 0 )) && speed_display=" ${C_ACCENT}$(_fmt_speed $speed_bytes)${C_RESET}"
    _cursor_up 3
    _clr_line
    local dl_status="${C_PRIMARY}${spin_char}${C_RESET} ${type_icon} ${type_color}${name}${C_RESET} ${C_MUTED}(${type})${size_display} ${C_INFO}下载中${C_RESET}${speed_display}"
    local dl_stripped="${dl_status//$'\033'[0-9;]*[a-zA-Z]/}"
    local dl_pad=$(( $(_get_terminal_width) - 2 - ${#dl_stripped} ))
    (( dl_pad < 1 )) && dl_pad=1
    echo "${C_BORDER}${B_V}${C_RESET} ${dl_status}${C_BORDER}$(printf "%${dl_pad}s" " ")${B_V}${C_RESET}"
    _clr_line
    _progress_bar "$completed_size" "$total_size" "$(( current_idx - 1 ))" "$num_selected"
    _clr_line
    _sub_progress_bar "$downloaded" "$pkg_size" "下载中" "$spin_idx"
    spin_idx=$(( spin_idx + 1 ))
    sleep 0.1
  done

  if (( timed_out == 1 )); then
    return 2
  fi

  wait "$fetch_pid"
  local fetch_exit=$?
  if (( fetch_exit != 0 )); then
    return 1
  fi

  # 兜底：若下载期间未解析到包大小，从日志最后一行解析
  if (( pkg_size <= 0 )); then
    local size_str=$(tr -d '\r' < "$log_file" | grep -oE '[0-9.]+ ?[kKMGT]i?B?' | head -1)
    if [[ -n "$size_str" ]]; then
      pkg_size=$(_parse_size "$size_str")
      if (( pkg_size > 0 )); then
        size_display=" ${C_MUTED}· $(_fmt_size $pkg_size)${C_RESET}"
        total_size=$(( total_size - pkg_sizes[idx] + pkg_size ))
        pkg_sizes[$idx]=$pkg_size
      fi
    fi
  fi
  return 0
}

# ---------- 参数解析 ----------
mode="interactive"
filter="all"
use_greedy=0
clean_logs=0
deep_prune=0

# ========== 子命令处理 ==========

# ck / check — 环境诊断
if [[ "${1:-}" == "ck" || "${1:-}" == "check" ]]; then
  shift
  _run_diagnose "$@"
  exit 0
fi

# ig / ignore — 屏蔽 cask
if [[ "${1:-}" == "ig" || "${1:-}" == "ignore" ]]; then
  if [[ -z "${2:-}" ]]; then
    echo "${C_ERROR}  ✗ 请指定要屏蔽的 cask 名称${C_RESET}"
    echo "  用法: brew ua ig <cask-name>"
    exit 1
  fi
  if _add_ignored_cask "$2"; then
    echo "${C_SUCCESS}  ✓ 已屏蔽 cask: ${C_BOLD}$2${C_RESET}"
    echo "${C_MUTED}  该 cask 将不会出现在更新列表中，直到手动解除屏蔽${C_RESET}"
  else
    echo "${C_WARN}  ⚠ cask \"$2\" 已经在屏蔽列表中${C_RESET}"
  fi
  exit 0
fi

# uig / unignore — 解除屏蔽
if [[ "${1:-}" == "uig" || "${1:-}" == "unignore" ]]; then
  if [[ -z "${2:-}" ]]; then
    echo "${C_ERROR}  ✗ 请指定要解除屏蔽的 cask 名称${C_RESET}"
    echo "  用法: brew ua uig <cask-name>"
    exit 1
  fi
  if _remove_ignored_cask "$2"; then
    echo "${C_SUCCESS}  ✓ 已解除屏蔽 cask: ${C_BOLD}$2${C_RESET}"
  else
    echo "${C_WARN}  ⚠ cask \"$2\" 不在屏蔽列表中${C_RESET}"
  fi
  exit 0
fi

# igl / ignored — 查看屏蔽列表
if [[ "${1:-}" == "igl" || "${1:-}" == "ignored" ]]; then
  local ignored_list
  ignored_list=($(_list_ignored_casks))
  local count=${#ignored_list[@]}
  if (( count == 0 )); then
    echo "${C_INFO}  ℹ 当前没有屏蔽任何 cask${C_RESET}"
  else
    echo "${C_BOLD}🚫 屏蔽列表（${count} 个 cask）：${C_RESET}"
    echo ""
    for c in "${ignored_list[@]}"; do
      [[ -n "$c" ]] && echo "  ${C_CASK}•${C_RESET} ${c}"
    done
    echo ""
    echo "${C_MUTED}  解除屏蔽: brew ua uig <cask-name>${C_RESET}"
  fi
  exit 0
fi

# ========== 模式与选项解析 ==========
for arg in "$@"; do
  case "$arg" in
    -a) use_greedy=1 ;;
    a|auto) mode="auto" ;;
    f|formula) filter="formula" ;;
    c|cask) filter="cask" ;;
    --clean-logs) clean_logs=1 ;;
    --prune) deep_prune=1 ;;
    -h|--help)
      _print_help
      exit 0
      ;;
  esac
done

# ---------- 主流程 ----------

# 高精度时间与数学函数（用于下载速度计算）
zmodload zsh/datetime 2>/dev/null
zmodload zsh/mathfunc 2>/dev/null

# 独立临时日志目录（避免 /tmp 固定文件名冲突与符号链接风险）
TMP_BASE=$(mktemp -d "${TMPDIR:-/tmp}/brew-ua.XXXXXX" 2>/dev/null)
[[ -z "$TMP_BASE" || ! -d "$TMP_BASE" ]] && TMP_BASE="/tmp"

# 当前版本（发版时同步更新；版本自检用）
BREW_UA_VERSION="1.8.5"

# 单实例锁：PID 文件 + kill -0 探测，陈旧锁自动清理
LOCK_FILE="$HOME/.config/brew-ua/brew-ua.lock"
mkdir -p "$HOME/.config/brew-ua"
if [[ -f "$LOCK_FILE" ]]; then
  local old_pid=$(cat "$LOCK_FILE" 2>/dev/null)
  if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
    echo "${C_ERROR}  ✗ 已有 brew-ua 实例在运行（PID $old_pid），请稍后再试${C_RESET}"
    echo "${C_MUTED}    若确认无其他实例，可删除 ${LOCK_FILE} 后重试${C_RESET}"
    exit 1
  fi
  rm -f "$LOCK_FILE"
fi
echo $$ > "$LOCK_FILE"

total_start=$(date +%s)

# ---- brew update ----
_section_title "🔄" "更新 Homebrew 源"

update_log="$TMP_BASE/update.log"
brew update > "$update_log" 2>&1 &
update_pid=$!

_hide_cursor
trap '_show_cursor' EXIT
trap '_cleanup_and_exit' INT TERM

update_start=$(date +%s)
spin_idx=0
echo "${C_MUTED}  准备中...${C_RESET}"

while kill -0 "$update_pid" 2>/dev/null; do
  now=$(date +%s)
  elapsed=$(( now - update_start ))

  local spin_count=${#SPIN_FRAMES[@]}
  local spin_pos=$(( (spin_idx % spin_count) + 1 ))
  local spin_char="$SPIN_FRAMES[$spin_pos]"

  # 从日志提取当前正在更新的源（如 "homebrew/core" 或 tap 名）
  local current_tap=""
  [[ -f "$update_log" ]] && current_tap=$(grep -oE 'Updating (homebrew/[a-z]+|[a-z0-9_-]+/[a-z0-9_-]+)' "$update_log" 2>/dev/null | tail -1 | sed 's/Updating //')

  _cursor_up 1
  if [[ -n "$current_tap" ]]; then
    echo "${C_PRIMARY}${spin_char}${C_RESET} ${C_INFO}正在更新源${C_RESET} ${C_MUTED}${current_tap}${C_RESET} ${C_MUTED}· ${elapsed}s${C_RESET}        "
  else
    echo "${C_PRIMARY}${spin_char}${C_RESET} ${C_INFO}正在更新源...${C_RESET} ${C_MUTED}· ${elapsed}s${C_RESET}        "
  fi

  spin_idx=$(( spin_idx + 1 ))
  sleep 0.1
done

wait "$update_pid"
update_exit=$?

update_end=$(date +%s)
update_dur=$(( update_end - update_start ))

_cursor_up 1
if (( update_exit == 0 )); then
  # 从日志提取所有更新过的源
  local updated_taps=$(grep -oE 'Updating (homebrew/[a-z]+|[a-z0-9_-]+/[a-z0-9_-]+)' "$update_log" 2>/dev/null | sed 's/Updating //' | sort -u | tr '\n' ' ')
  if [[ -n "$updated_taps" ]]; then
    echo "${C_SUCCESS}  ✓${C_RESET} ${C_MUTED}源更新完成 · ${update_dur}s${C_RESET}"
    echo "${C_MUTED}  已更新: ${updated_taps}${C_RESET}"
  else
    echo "${C_SUCCESS}  ✓${C_RESET} ${C_MUTED}源更新完成 · ${update_dur}s${C_RESET}"
  fi
else
  echo "${C_ERROR}  ✗ 源更新失败 · ${update_dur}s${C_RESET}"
  echo "${C_MUTED}  日志: ${update_log}${C_RESET}"
fi

_show_cursor
trap - EXIT INT TERM
(( update_exit == 0 )) && rm -f "$update_log"

# ---- 获取过期包列表 ----
cask_extra_args=()
[[ $use_greedy -eq 1 ]] && cask_extra_args=(--greedy)

formulae=()
casks=()
ignored_outdated_casks=()

local self_update_available=0

if [[ "$filter" != "cask" ]]; then
  local all_outdated_formulae=()
  all_outdated_formulae=($(brew outdated --formula --quiet))
  for f in "${all_outdated_formulae[@]}"; do
    if [[ "$f" == "brew-update-all" ]]; then
      self_update_available=1
    else
      formulae+=("$f")
    fi
  done
fi
if [[ "$filter" != "formula" ]]; then
  all_outdated_casks=($(brew outdated --cask $cask_extra_args --quiet))
  for c in "${all_outdated_casks[@]}"; do
    if _is_cask_ignored "$c"; then
      ignored_outdated_casks+=("$c")
    else
      casks+=("$c")
    fi
  done
fi

num_f=${#formulae[@]}
num_c=${#casks[@]}
num_ignored=${#ignored_outdated_casks[@]}
total=$((num_f + num_c))

# ---- 显示可更新列表 ----
echo ""
_draw_top_border "📦 可更新的包"

if (( num_f > 0 )); then
  _line_left "${C_BOLD}${C_FORMULA}🍺 Formulae${C_RESET}  ${C_MUTED}(${num_f} 个)${C_RESET}"
  _draw_mid_border
  local idx=0
  for f in "${formulae[@]}"; do
    ((idx++))
    local num_str=$(printf "%3d" "$idx")
    _line_left "  ${C_MUTED}[${C_RESET}${C_PRIMARY}${C_BOLD}${num_str}${C_RESET}${C_MUTED}]${C_RESET}  ${C_FORMULA}${f}${C_RESET}"
  done
fi

if (( num_f > 0 && num_c > 0 )); then
  _draw_mid_border
fi

if (( num_c > 0 )); then
  _line_left "${C_BOLD}${C_CASK}📱 Casks${C_RESET}  ${C_MUTED}(${num_c} 个)${C_RESET}"
  _draw_mid_border
  local idx=$num_f
  for c in "${casks[@]}"; do
    ((idx++))
    local num_str=$(printf "%3d" "$idx")
    _line_left "  ${C_MUTED}[${C_RESET}${C_PRIMARY}${C_BOLD}${num_str}${C_RESET}${C_MUTED}]${C_RESET}  ${C_CASK}${c}${C_RESET}"
  done
fi

if (( num_ignored > 0 )); then
  if (( total > 0 )); then
    _draw_mid_border
  fi
  _line_left "${C_WARN}🚫 已屏蔽的 cask（${num_ignored} 个有更新）${C_RESET}"
  local ignored_idx=0
  for c in "${ignored_outdated_casks[@]}"; do
    ((ignored_idx++))
    _line_left "     ${C_MUTED}${ignored_idx}. ${C_WARN}${c}${C_RESET}  ${C_MUTED}（brew ua unignore ${c} 解除）${C_RESET}"
  done
fi

if (( total == 0 )); then
  _line_centered "${C_SUCCESS}${C_BOLD}🎉 所有包已是最新！${C_RESET}"
  _draw_bottom_border
  echo ""
  exit 0
fi

_draw_bottom_border

if [[ $use_greedy -eq 1 ]]; then
  echo "${C_MUTED}  💡 已启用 -a，包含自带自动更新的应用（Chrome / VS Code 等）${C_RESET}"
fi
if (( num_ignored > 0 )); then
  echo "${C_WARN}  ⚠ 有 ${num_ignored} 个 cask 被屏蔽，不会被升级${C_RESET}"
  echo "${C_MUTED}     查看屏蔽列表: brew ua ignored${C_RESET}"
  echo "${C_MUTED}     解除屏蔽: brew ua unignore <cask-name>${C_RESET}"
fi
if (( self_update_available == 1 )); then
  echo "${C_WARN}  🎉 brew-update-all 有新版本，升级完成后请执行: ${C_BOLD}brew upgrade brew-update-all${C_RESET}"
fi

# ---- 用户选择 ----
selected=()
casks_to_ignore=()

if [[ "$mode" == "auto" ]]; then
  selected=($(seq 1 $total))
else
  # 交互选择：支持屏蔽后循环重选，不再 exec 重跑（避免重复 brew update）
  while true; do
    echo ""
    echo "${C_BOLD}${C_PRIMARY}🎯 选择要升级的包${C_RESET}"
    echo "${C_MUTED}  回车=全部，支持空格分隔（1 3 5）或范围（2-7）${C_RESET}"
    echo "${C_MUTED}  屏蔽 cask: 序号+i（如 5i 表示屏蔽第5个 cask）${C_RESET}"
    echo -n "  ${C_BOLD}输入序号:${C_RESET} "
    read input

    selected=()
    casks_to_ignore=()

    if [[ -z "$input" ]]; then
      selected=($(seq 1 $total))
      break
    fi

    for token in ${(z)input}; do
      if [[ "$token" =~ ^([0-9]+)i$ ]]; then
        local ignore_idx=$match[1]
        if (( ignore_idx >= 1 && ignore_idx <= total )); then
          if (( ignore_idx > num_f )); then
            local cask_pos=$(( ignore_idx - num_f ))
            casks_to_ignore+=("${casks[$cask_pos]}")
          else
            echo ""
            echo "${C_WARN}  ⚠ 第 ${ignore_idx} 个是 formula，暂不支持屏蔽 formula${C_RESET}"
          fi
        fi
      elif [[ "$token" =~ ^[0-9]+-[0-9]+$ ]]; then
        for i in $(seq ${token%-*} ${token#*-}); do
          (( i >= 1 && i <= total )) && selected+=($i)
        done
      elif [[ "$token" =~ ^[0-9]+$ ]]; then
        (( token >= 1 && token <= total )) && selected+=($token)
      fi
    done

    if (( ${#casks_to_ignore} > 0 )); then
      for c in "${casks_to_ignore[@]}"; do
        _add_ignored_cask "$c"
        echo ""
        echo "${C_SUCCESS}  ✓ 已屏蔽 cask: ${C_BOLD}${c}${C_RESET}"
      done
      echo "${C_MUTED}  解除屏蔽: brew ua unignore <cask-name>${C_RESET}"
      # 从 casks 剔除被屏蔽项并更新计数，循环重新选择
      local new_casks=()
      local c ig skip
      for c in "${casks[@]}"; do
        skip=0
        for ig in "${casks_to_ignore[@]}"; do
          [[ "$c" == "$ig" ]] && skip=1
        done
        (( skip == 0 )) && new_casks+=("$c")
      done
      casks=("${new_casks[@]}")
      num_c=${#casks[@]}
      total=$((num_f + num_c))
      if (( total == 0 )); then
        echo ""
        echo "${C_INFO}  ℹ 没有可更新的包了${C_RESET}"
        exit 0
      fi
      echo ""
      echo "${C_INFO}  ℹ 列表已更新（剩余 ${total} 个），请重新选择${C_RESET}"
      continue
    fi

    if (( ${#selected[@]} == 0 )); then
      echo ""
      echo "${C_ERROR}  ✗ 没有选中有效的序号，已取消${C_RESET}"
      exit 1
    fi
    break
  done
fi

selected=(${(u)selected})
num_selected=${#selected[@]}

echo ""
echo "${C_INFO}  ℹ 已选择 ${C_BOLD}${num_selected}${C_RESET}${C_INFO} 个包进行升级${C_RESET}"

# ---- 构建选中包列表（大小动态获取，提升启动速度） ----
pkg_sizes=()
pkg_names=()
pkg_types=()
pkg_type_colors=()
pkg_type_icons=()
total_size=0

for i in $selected; do
  if [[ $i -le $num_f ]]; then
    name=$formulae[$i]
    type="formula"
    type_color="$C_FORMULA"
    type_icon="🍺"
  else
    name=$casks[$((i - num_f))]
    type="cask"
    type_color="$C_CASK"
    type_icon="📱"
  fi
  pkg_sizes+=(0)
  pkg_names+=("$name")
  pkg_types+=("$type")
  pkg_type_colors+=("$type_color")
  pkg_type_icons+=("$type_icon")
done

# ---- 逐个升级 ----
echo ""
_draw_top_border "🚀 升级进度"
echo -n ""

success_count=0
fail_count=0
failed_names=()
success_names=()
pkg_times=()
current_idx=0
completed_size=0

_hide_cursor
trap '_show_cursor' EXIT
trap '_cleanup_and_exit' INT TERM

_line_left "  ${C_MUTED}阶段 1/2：逐个下载更新包...${C_RESET}"
_progress_bar 0 0 0 "$num_selected"
_sub_progress_bar 0 0 "等待下载..." 0

# ========== 阶段 1：逐个下载（速度/超时/失败隔离） ==========
dl_ok_names=()
dl_ok_types=()
dl_ok_sizes=()
dl_fail_names=()
dl_fail_reasons=()
current_idx=0
dl_done=0

for (( idx=1; idx<=num_selected; idx++ )); do
  ((current_idx++))

  name=${pkg_names[$idx]}
  type=${pkg_types[$idx]}
  type_color=${pkg_type_colors[$idx]}
  type_icon=${pkg_type_icons[$idx]}
  pkg_size=${pkg_sizes[$idx]}

  local size_display=""
  if (( pkg_size > 0 )); then
    size_display=" ${C_MUTED}· $(_fmt_size $pkg_size)${C_RESET}"
  else
    size_display=" ${C_MUTED}· ?${C_RESET}"
  fi

  _cursor_up 3
  _clr_line
  local status_line="${type_icon} ${type_color}${name}${C_RESET} ${C_MUTED}(${type})${size_display} ${C_INFO}准备下载...${C_RESET}"
  local stripped_status="${status_line//$'\033'[0-9;]*[a-zA-Z]/}"
  local pad=$(( $(_get_terminal_width) - 2 - ${#stripped_status} ))
  (( pad < 1 )) && pad=1
  echo "${C_BORDER}${B_V}${C_RESET} ${status_line}${C_BORDER}$(printf "%${pad}s" " ")${B_V}${C_RESET}"
  _clr_line
  _progress_bar 0 0 "$(( current_idx - 1 ))" "$num_selected"
  _clr_line
  _sub_progress_bar 0 0 "等待下载..." 0

  _run_fetch "$name" "$type" "$idx"
  local fetch_rc=$?

  if (( fetch_rc == 0 )); then
    dl_ok_names+=("$name")
    dl_ok_types+=("$type")
    dl_ok_sizes+=("$pkg_size")
    dl_done=$(( dl_done + 1 ))
    _cursor_up 3
    _clr_line
    local ok_line="${C_SUCCESS}✓${C_RESET} ${type_icon} ${type_color}${name}${C_RESET} ${C_MUTED}(${type})${size_display} ${C_SUCCESS}已下载${C_RESET}"
    local ok_stripped="${ok_line//$'\033'[0-9;]*[a-zA-Z]/}"
    local ok_pad=$(( $(_get_terminal_width) - 2 - ${#ok_stripped} ))
    (( ok_pad < 1 )) && ok_pad=1
    echo "${C_BORDER}${B_V}${C_RESET} ${ok_line}${C_BORDER}$(printf "%${ok_pad}s" " ")${B_V}${C_RESET}"
    _clr_line
    _progress_bar 0 0 "$dl_done" "$num_selected"
    _clr_line
    _sub_progress_bar "$pkg_size" "$pkg_size" "已下载" 0
  else
    dl_fail_names+=("$name")
    if (( fetch_rc == 2 )); then
      dl_fail_reasons+=("下载超时")
    else
      dl_fail_reasons+=("下载失败")
    fi
    _cursor_up 3
    _clr_line
    local fail_line="${C_ERROR}✗${C_RESET} ${type_icon} ${type_color}${name}${C_RESET} ${C_MUTED}(${type})${size_display} ${C_ERROR}${dl_fail_reasons[-1]}${C_RESET}"
    local fail_stripped="${fail_line//$'\033'[0-9;]*[a-zA-Z]/}"
    local fail_pad=$(( $(_get_terminal_width) - 2 - ${#fail_stripped} ))
    (( fail_pad < 1 )) && fail_pad=1
    echo "${C_BORDER}${B_V}${C_RESET} ${fail_line}${C_BORDER}$(printf "%${fail_pad}s" " ")${B_V}${C_RESET}"
    _clr_line
    _progress_bar 0 0 "$dl_done" "$num_selected"
    _clr_line
    _sub_progress_bar 0 0 "下载失败" 0
  fi
done

# 阶段 1 汇总帧
_cursor_up 3
_clr_line
local dl_summary="${C_INFO}📥 下载完成：${C_SUCCESS}${#dl_ok_names[@]} 个成功${C_RESET} ${C_ERROR}/${#dl_fail_names[@]} 个失败${C_RESET} ${C_MUTED}· 进入安装阶段${C_RESET}"
local dl_s="${dl_summary//$'\033'[0-9;]*[a-zA-Z]/}"
local dl_p=$(( $(_get_terminal_width) - 2 - ${#dl_s} ))
(( dl_p < 1 )) && dl_p=1
echo "${C_BORDER}${B_V}${C_RESET} ${dl_summary}${C_BORDER}$(printf "%${dl_p}s" " ")${B_V}${C_RESET}"
_clr_line
_progress_bar 0 0 "$dl_done" "$num_selected"
_clr_line
_sub_progress_bar 0 0 "阶段 1 完成" 0

# ========== 阶段 2：逐个安装（只装下载成功的） ==========
success_count=0
fail_count=0
failed_names=()
success_names=()
pkg_times=()
completed_size=0
current_idx=0
install_total=${#dl_ok_names[@]}
install_done=0

for (( i=1; i<=install_total; i++ )); do
  ((current_idx++))

  name=${dl_ok_names[$i]}
  type=${dl_ok_types[$i]}
  pkg_size=${dl_ok_sizes[$i]}
  type_color=$([[ "$type" == "cask" ]] && echo "$C_CASK" || echo "$C_FORMULA")
  type_icon=$([[ "$type" == "cask" ]] && echo "📱" || echo "🍺")
  local size_display=""
  if (( pkg_size > 0 )); then
    size_display=" ${C_MUTED}· $(_fmt_size $pkg_size)${C_RESET}"
  else
    size_display=" ${C_MUTED}· ?${C_RESET}"
  fi

  local log_file="$TMP_BASE/$name.log"

  _cursor_up 3
  _clr_line
  local status_line="${type_icon} ${type_color}${name}${C_RESET} ${C_MUTED}(${type})${size_display} ${C_INFO}安装中...${C_RESET}"
  local stripped_status="${status_line//$'\033'[0-9;]*[a-zA-Z]/}"
  local pad=$(( $(_get_terminal_width) - 2 - ${#stripped_status} ))
  (( pad < 1 )) && pad=1
  echo "${C_BORDER}${B_V}${C_RESET} ${status_line}${C_BORDER}$(printf "%${pad}s" " ")${B_V}${C_RESET}"
  _clr_line
  _progress_bar 0 0 "$(( current_idx - 1 ))" "$install_total"
  _clr_line
  _sub_progress_bar 0 0 "等待安装..." 0

  pkg_start=$(date +%s)
  local brew_pid=""
  if [[ "$type" == "cask" ]]; then
    brew reinstall --cask "$name" > "$log_file" 2>&1 &
  else
    brew upgrade --formula "$name" > "$log_file" 2>&1 &
  fi
  brew_pid=$!

  # 安装轮询（3 行界面）
  spin_idx=0
  local downloaded=$pkg_size
  local log_offset=0
  local phase="安装中"
  while [[ -n "$brew_pid" ]] && kill -0 "$brew_pid" 2>/dev/null; do
    _cursor_up 3
    _clr_line
    local log_content=""
    if [[ -f "$log_file" ]]; then
      log_content=$(tail -c +$(( log_offset + 1 )) "$log_file" 2>/dev/null)
      local new_bytes=${#log_content}
      log_offset=$(( log_offset + new_bytes ))
    fi
    local spin_count=${#SPIN_FRAMES[@]}
    local spin_pos=$(( (spin_idx % spin_count) + 1 ))
    local spin_char="$SPIN_FRAMES[$spin_pos]"
    local pkg_status_line="${C_PRIMARY}${spin_char}${C_RESET} ${type_icon} ${type_color}${name}${C_RESET} ${C_MUTED}(${type})${size_display} ${C_INFO}${phase}...${C_RESET}"
    local stripped_status="${pkg_status_line//$'\033'[0-9;]*[a-zA-Z]/}"
    local pad=$(( $(_get_terminal_width) - 2 - ${#stripped_status} ))
    (( pad < 1 )) && pad=1
    echo "${C_BORDER}${B_V}${C_RESET} ${pkg_status_line}${C_BORDER}$(printf "%${pad}s" " ")${B_V}${C_RESET}"
    _clr_line
    _progress_bar 0 0 "$(( current_idx - 1 ))" "$install_total"
    _clr_line
    local sub_current=$downloaded
    local sub_total=$pkg_size
    if (( pkg_size <= 0 )); then
      sub_current=0
      sub_total=0
    fi
    _sub_progress_bar "$sub_current" "$sub_total" "$phase" "$spin_idx"
    spin_idx=$(( spin_idx + 1 ))
    sleep 0.1
  done

  wait "$brew_pid"
  local brew_exit=$?

  pkg_end=$(date +%s)
  pkg_dur=$(( pkg_end - pkg_start ))
  pkg_times+=("$pkg_dur")

  _cursor_up 3
  _clr_line
  if (( brew_exit == 0 )); then
    success_count=$(( success_count + 1 ))
    success_names+=("$name")
    completed_size=$(( completed_size + pkg_size ))
    (( completed_size > total_size )) && completed_size=$total_size
    install_done=$(( install_done + 1 ))
    echo "${C_BORDER}${B_V}${C_RESET} ${C_SUCCESS}✓${C_RESET} ${type_color}${name}${C_RESET} ${C_MUTED}升级完成 · $(_fmt_duration $pkg_dur)${C_RESET} ${C_BORDER}${B_V}${C_RESET}"
  else
    fail_count=$(( fail_count + 1 ))
    failed_names+=("$name")
    completed_size=$(( completed_size + pkg_size ))
    (( completed_size > total_size )) && completed_size=$total_size
    install_done=$(( install_done + 1 ))
    echo "${C_BORDER}${B_V}${C_RESET} ${C_ERROR}✗${C_RESET} ${type_color}${name}${C_RESET} ${C_ERROR}升级失败${C_RESET} ${C_MUTED}· $(_fmt_duration $pkg_dur)${C_RESET} ${C_BORDER}${B_V}${C_RESET}"
  fi

  _clr_line
  _progress_bar 0 0 "$install_done" "$install_total"

  _clr_line
  local next_msg=$([[ $current_idx -lt $install_total ]] && echo "下一个准备中..." || echo "全部完成")
  local stripped_next="${next_msg//$'\033'[0-9;]*[a-zA-Z]/}"
  local next_pad=$(( $(_get_terminal_width) - 2 - ${#stripped_next} - 2 ))
  (( next_pad < 1 )) && next_pad=1
  echo "${C_BORDER}${B_V}${C_RESET} ${C_MUTED}${next_msg}${C_RESET}${C_BORDER}$(printf "%${next_pad}s" " ")${B_V}${C_RESET}"
done

# 下载失败/超时的包并入失败统计
for (( f=1; f<=${#dl_fail_names[@]}; f++ )); do
  fail_count=$(( fail_count + 1 ))
  failed_names+=("${dl_fail_names[$f]}")
  pkg_times+=("0")
done

_show_cursor
trap - EXIT INT TERM

_draw_bottom_border

# ---- cleanup ----
echo ""
_section_title "🧹" "清理旧版本"
brew cleanup
echo "${C_SUCCESS}  ✓ 清理完成${C_RESET}"

if (( deep_prune == 1 )); then
  echo ""
  echo "${C_INFO}  ℹ 正在深度清理下载缓存...${C_RESET}"
  brew cleanup --prune=all
  echo "${C_SUCCESS}  ✓ 深度清理完成${C_RESET}"
fi

if (( clean_logs == 1 )); then
  echo ""
  echo "${C_INFO}  ℹ 清理本次产生的临时日志...${C_RESET}"
  if [[ -d "$TMP_BASE" ]]; then
    local log_count=$(find "$TMP_BASE" -type f 2>/dev/null | wc -l | tr -d ' ')
    rm -rf "$TMP_BASE"
    echo "${C_SUCCESS}  ✓ 已清理临时日志目录（${log_count} 个文件）${C_RESET}"
  else
    echo "${C_MUTED}  - 无临时日志${C_RESET}"
  fi
fi

# ---- 版本自检（静默失败，不打扰；brew outdated 已提示则跳过）----
LATEST_TAG=""
if (( self_update_available == 0 )); then
  LATEST_TAG=$(curl -fsSL --max-time 3 "https://api.github.com/repos/yingshu0218/homebrew-update-all/releases/latest" 2>/dev/null | grep -oE '"tag_name"[[:space:]]*:[[:space:]]*"[^"]+"' | head -1 | sed 's/.*"v//; s/"//')
fi

# ---- 统计摘要 ----
total_end=$(date +%s)
total_dur=$(( total_end - total_start ))

echo ""
_draw_top_border "📊 升级统计"

_line_left "  ${C_BOLD}🕐 总耗时:${C_RESET}  ${C_PRIMARY}$(_fmt_duration $total_dur)${C_RESET}"
_draw_mid_border
_line_left "  ${C_BOLD}📦 总数量:${C_RESET}  ${num_selected} 个包"
_line_left "     ${C_SUCCESS}✓ 成功:${C_RESET}  ${success_count} 个"
_line_left "     ${C_ERROR}✗ 失败:${C_RESET}  ${fail_count} 个"
_line_left "     ${C_MUTED}成功率:${C_RESET}  $(( num_selected > 0 ? success_count * 100 / num_selected : 0 ))%"

if (( fail_count > 0 )); then
  _draw_mid_border
  _line_left "  ${C_ERROR}${C_BOLD}失败的包:${C_RESET}"
  local fn
  for fn in $failed_names; do
    _line_left "     ${C_ERROR}• ${fn}${C_RESET}  ${C_MUTED}日志: ${TMP_BASE}/${fn}.log${C_RESET}"
  done
fi

if (( success_count > 0 )); then
  _draw_mid_border
  _line_left "  ${C_SUCCESS}${C_BOLD}成功的包:${C_RESET}"
  local count=0
  local line=""
  for sn in $success_names; do
    if (( count == 0 )); then
      line="     ${C_SUCCESS}• ${sn}${C_RESET}"
      count=1
    else
      line="${line}${C_MUTED}, ${C_RESET}${C_SUCCESS}${sn}${C_RESET}"
      count=$(( count + 1 ))
    fi
    if (( count >= 5 )); then
      _line_left "$line"
      count=0
      line=""
    fi
  done
  if (( count > 0 )); then
    _line_left "$line"
  fi
fi

_draw_bottom_border
echo ""

# 新版本提示（仅当 GitHub 最新 tag 确实比本地版本新）
if [[ -n "$LATEST_TAG" && "$LATEST_TAG" != "$BREW_UA_VERSION" && "$(printf '%s\n%s' "$BREW_UA_VERSION" "$LATEST_TAG" | sort -V | tail -1)" == "$LATEST_TAG" ]]; then
  echo "${C_WARN}  ⚡ 发现新版本 v${LATEST_TAG}（当前 v${BREW_UA_VERSION}）${C_RESET}"
  echo "${C_MUTED}     升级: brew upgrade brew-update-all${C_RESET}"
  echo ""
fi

# 释放单实例锁
rm -f "$LOCK_FILE"

if (( fail_count > 0 )); then
  echo "${C_WARN}  ⚠  有 ${fail_count} 个包升级失败，可查看上方日志排查问题${C_RESET}"
  echo ""
  exit 1
fi

echo "${C_SUCCESS}${C_BOLD}  ✅ 全部完成！${C_RESET}"
echo ""
